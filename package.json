{
  "name": "@hoopgram/hcode",
  "version": "0.10.3",
  "description": "Hoop Code — HoopGram's self-contained AI coding agent for your terminal, with zero third-party runtime packages.",
  "license": "AGPL-3.0",
  "type": "module",
  "bin": {
    "hcode": "bin/hcode.js",
    "hcode-supervise": "bin/hcode-supervise.js"
  },
  "files": [
    "bin/",
    "src/",
    "launchd/",
    "FULL-AGENCY.md",
    "README.md",
    "DEVELOPING.md",
    "ARCHITECTURE.md",
    "CAPABILITY-BOUNDARY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check bin/hcode.js && node --check bin/hcode-supervise.js && for f in src/*.js scripts/*.mjs; do node --check $f; done",
    "build:native": "node scripts/build-native.mjs --target current",
    "build:native:all": "node scripts/build-native.mjs --target all"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-assistant",
    "hoopgram",
    "hoop",
    "claude-code",
    "codex",
    "sandbox"
  ],
  "homepage": "https://hoopgram.ai/hcode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoopgram/hcode.git"
  },
  "bugs": {
    "url": "https://github.com/hoopgram/hcode/issues"
  },
  "author": "HoopGram"
}
